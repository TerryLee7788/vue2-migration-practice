{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/inject-skills.mjs",
            "timeout": 10,
            "statusMessage": "Loading project skill conventions..."
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node .claude/hooks/build-check.mjs",
            "timeout": 120,
            "statusMessage": "Running npm run build..."
          }
        ]
      }
    ]
  }
}
